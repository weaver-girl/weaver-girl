    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!--
                                Relocations: snakeyaml + slf4j + ByteBuddy.
                                ByteBuddy is now relocated (net.bytebuddy -> shaded.net.bytebuddy).
                                This previously broke bootstrap because the agent ran on the system
                                ClassLoader and ByteBuddy loaded some of its own classes by their
                                original name; under the isolated AgentClassLoader (see
                                AgentClassLoader + WeaverGirlAgent.run) the agent's ByteBuddy is
                                resolved child-first from this jar, so relocation holds. Verified by
                                the cross-JDK smoke + interception assertion; /stats reports
                                byteBuddyClassLoader=AgentClassLoader.

                                Isolation is provided PRIMARILY by the child-first AgentClassLoader;
                                relocation is defense-in-depth so the agent's ByteBuddy can never
                                collide with a host's own net.bytebuddy even via the bootstrap
                                injection path used for bootstrap-loaded instrumented targets. The
                                smoke exercises app-loaded targets; the bootstrap-injection path is
                                not covered by it and is expected to be rare (plugins match app-loaded
                                implementations, not bootstrap-loaded JDK interfaces).
                            -->
                            <relocations>
                                <relocation>
                                    <pattern>org.yaml.snakeyaml</pattern>
                                    <shadedPattern>shaded.org.yaml.snakeyaml</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.slf4j</pattern>
                                    <shadedPattern>com.github.cc11001100.weavergirl.shade.org.slf4j</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>net.bytebuddy</pattern>
                                    <shadedPattern>shaded.net.bytebuddy</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Premain-Class>com.github.cc11001100.weavergirl.agent.WeaverGirlAgent</Premain-Class>
                                        <Agent-Class>com.github.cc11001100.weavergirl.agent.WeaverGirlAgent</Agent-Class>
                                        <Can-Redefine-Classes>true</Can-Redefine-Classes>
                                        <Can-Retransform-Classes>true</Can-Retransform-Classes>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- One jar per capability, shipped beside the agent and loaded only when enabled.
                 provided-scope deps are excluded from the shaded jar above, so this is what puts them
                 in the distribution. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-plugins</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeGroupIds>com.github.cc11001100</includeGroupIds>
                            <!-- Every internal provided-scope dependency is a capability jar. Selecting
                                 by scope keeps this list in step with the dependency list above: adding
                                 a plugin dependency is enough, no second list to edit. -->
                            <includeScope>provided</includeScope>
                            <outputDirectory>${project.build.directory}/plugins</outputDirectory>
                            <stripVersion>false</stripVersion>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

