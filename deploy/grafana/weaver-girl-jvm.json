  "panels": [
    {
      "title": "JVM Heap Memory",
      "description": "Source: weavergirl_jvm_memory_{used,committed,max}_bytes with area=\"heap\".",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "weavergirl_jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "Used",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "expr": "weavergirl_jvm_memory_max_bytes{area=\"heap\"}",
          "legendFormat": "Max",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "expr": "weavergirl_jvm_memory_committed_bytes{area=\"heap\"}",
          "legendFormat": "Committed",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "title": "JVM Non-Heap Memory",
      "description": "Source: weavergirl_jvm_memory_used_bytes with area=\"nonheap\".",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "weavergirl_jvm_memory_used_bytes{area=\"nonheap\"}",
          "legendFormat": "Non-Heap Used",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "expr": "weavergirl_jvm_memory_committed_bytes{area=\"nonheap\"}",
          "legendFormat": "Non-Heap Committed",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "title": "Threads",
      "description": "Source: weavergirl_jvm_threads_current and weavergirl_jvm_threads_peak. There is no daemon-thread counter in the exposition format, so peak stands in for it.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "weavergirl_jvm_threads_current",
          "legendFormat": "Current",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        },
        {
          "expr": "weavergirl_jvm_threads_peak",
          "legendFormat": "Peak",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ]
    },
    {
      "title": "GC Time",
      "description": "Wall-clock time spent in GC per second, by collector. Source: weavergirl_jvm_gc_collection_time_seconds_total (a cumulative counter, not a pause histogram).",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (gc) (rate(weavergirl_jvm_gc_collection_time_seconds_total[$__rate_interval]))",
          "legendFormat": "{{gc}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "title": "GC Collections",
      "description": "Collections per second, by collector. Source: weavergirl_jvm_gc_collection_count_total.",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (gc) (rate(weavergirl_jvm_gc_collection_count_total[$__rate_interval]))",
          "legendFormat": "{{gc}}",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "title": "Heap Trend",
      "description": "Heap growth per second over the selected range.",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "deriv(weavergirl_jvm_memory_used_bytes{area=\"heap\"}[$__rate_interval])",
          "legendFormat": "Heap Trend",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "title": "Classes Loaded / Uptime",
