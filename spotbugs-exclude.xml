<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude test classes from SpotBugs analysis -->
    <Match>
        <Source name="~.*Test\.java"/>
    </Match>

    <!-- Exclude generated ByteBuddy advice classes. Advice parameters such as
         @Advice.Argument(readOnly = false) and @Advice.Return(readOnly = false) are assigned at
         the end of the advice body purely so ByteBuddy can write them back into the woven
         method; the advice never reads them again, so SpotBugs sees a dead store / dead
         parameter on every one of them. -->
    <Match>
        <Class name="~.*Advice.*"/>
        <Bug pattern="URF_UNREAD_FIELD,UWF_UNWRITTEN_FIELD,DLS_DEAD_LOCAL_STORE,IP_PARAMETER_IS_DEAD_BUT_OVERWRITTEN"/>
    </Match>

    <!-- Sample application code has relaxed standards -->
    <Match>
        <Package name="~com\.github\.cc11001100\.weavergirl\.sample.*"/>
    </Match>

    <!-- ByteBuddy inlined code patterns -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE"/>
    </Match>

    <!-- ThreadLocal patterns in agent context are intentional -->
    <Match>
        <Class name="~.*ThreadContext.*"/>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>
</FindBugsFilter>
