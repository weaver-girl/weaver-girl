<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.cc11001100</groupId>
        <artifactId>weaver-girl</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>weaver-girl-agent</artifactId>
    <packaging>jar</packaging>

    <name>Weaver Girl - Agent</name>
    <description>Java Agent entry point with shaded dependencies</description>

    <dependencies>
        <!-- Internal -->
        <dependency>
            <groupId>com.github.cc11001100</groupId>
            <artifactId>weaver-girl-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.cc11001100</groupId>
            <artifactId>weaver-girl-annotation-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.cc11001100</groupId>
            <artifactId>weaver-girl-annotation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.cc11001100</groupId>
            <artifactId>weaver-girl-plugins</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy-agent</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!--
                                Relocations: snakeyaml + slf4j + ByteBuddy.
                                ByteBuddy is now relocated (net.bytebuddy -> shaded.net.bytebuddy).
                                This previously broke bootstrap because the agent ran on the system
                                ClassLoader and ByteBuddy loaded some of its own classes by their
                                original name; under the isolated AgentClassLoader (see
                                AgentClassLoader + WeaverGirlAgent.run) the agent's ByteBuddy is
                                resolved child-first from this jar, so relocation holds. Verified by
                                the cross-JDK smoke + interception assertion; /stats reports
                                byteBuddyClassLoader=AgentClassLoader.

                                Isolation is provided PRIMARILY by the child-first AgentClassLoader;
                                relocation is defense-in-depth so the agent's ByteBuddy can never
                                collide with a host's own net.bytebuddy even via the bootstrap
                                injection path used for bootstrap-loaded instrumented targets. The
                                smoke exercises app-loaded targets; the bootstrap-injection path is
                                not covered by it and is expected to be rare (plugins match app-loaded
                                implementations, not bootstrap-loaded JDK interfaces).
                            -->
                            <relocations>
                                <relocation>
                                    <pattern>org.yaml.snakeyaml</pattern>
                                    <shadedPattern>shaded.org.yaml.snakeyaml</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.slf4j</pattern>
                                    <shadedPattern>com.github.cc11001100.weavergirl.shade.org.slf4j</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>net.bytebuddy</pattern>
                                    <shadedPattern>shaded.net.bytebuddy</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Premain-Class>com.github.cc11001100.weavergirl.agent.WeaverGirlAgent</Premain-Class>
                                        <Agent-Class>com.github.cc11001100.weavergirl.agent.WeaverGirlAgent</Agent-Class>
                                        <Can-Redefine-Classes>true</Can-Redefine-Classes>
                                        <Can-Retransform-Classes>true</Can-Retransform-Classes>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
