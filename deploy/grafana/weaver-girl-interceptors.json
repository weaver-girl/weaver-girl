{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Interception Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(weavergirl_interceptor_invocations_total[5m]))", "legendFormat": "Intercepts/sec" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      }
    },
    {
      "title": "Interception Duration (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le) (rate(weavergirl_interceptor_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(weavergirl_interceptor_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(weavergirl_interceptor_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "title": "Active Interceptors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        { "expr": "weavergirl_agent_registered_interceptors", "legendFormat": "Definitions" }
      ]
    },
    {
      "title": "Active Plugins",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "targets": [
        { "expr": "count(count by (plugin) (weavergirl_plugin_state))", "legendFormat": "Plugins" }
      ]
    },
    {
      "title": "Transformed Classes",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [
        { "expr": "weavergirl_agent_transformations_total", "legendFormat": "Classes" }
      ]
    },
    {
      "title": "Interception Errors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "targets": [
        { "expr": "sum(weavergirl_interceptor_errors_total)", "legendFormat": "Errors" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } },
        "overrides": []
      }
    },
    {
      "title": "Slow Calls",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum by (interceptor) (weavergirl_interceptor_slow_calls_total)", "legendFormat": "{{interceptor}}" }
      ]
    },
    {
      "title": "Top 10 Slowest Interceptors",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "topk(10, sum by (interceptor) (weavergirl_interceptor_duration_seconds_sum) / sum by (interceptor) (weavergirl_interceptor_invocations_total))", "legendFormat": "{{interceptor}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["weaver-girl", "interceptors"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Weaver-Girl: Interceptor Performance",
