<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.cc11001100</groupId>
        <artifactId>weaver-girl</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>weaver-girl-sample</artifactId>
    <packaging>jar</packaging>

    <name>Weaver Girl - Sample</name>
    <description>Sample applications demonstrating Weaver Girl usage</description>

    <build>
        <plugins>
            <!-- The sample is a demo application, not a published library: a release must not
                 push its coordinates (or its Jetty/H2 test dependencies) to Maven Central. -->
            <plugin>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!-- docs/examples holds the plugin examples the developer guide links to. They are
                 sources, not a module, so nothing used to compile them and one could rot for a
                 release without anyone noticing. Compiling them as test sources of this module
                 gets them onto the plugin API's class path and makes `mvn test` fail on a broken
                 example. This module is never deployed, so the extra classes stay out of any
                 published artifact. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.8.0</version>
                <executions>
                    <execution>
                        <id>compile-docs-examples</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../docs/examples</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The audit plugin ships as its own jar, the way a third-party plugin does: its own
                 SPI entry and its own contract declaration, dropped into plugins/ next to the agent.
                 It carries only the plugin classes, not the payment service, or the plugin would bring
                 the application along with it. The classes and the declarations come from different
                 directories, so they are staged into one directory and jarred from there. -->
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>stage-audit-plugin</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/audit-plugin"/>
                                <copy todir="${project.build.directory}/audit-plugin">
                                    <fileset dir="${project.build.outputDirectory}" includes="com/github/cc11001100/weavergirl/sample/audit/AuditPlugin*.class"/>
                                </copy>
                                <copy todir="${project.build.directory}/audit-plugin">
                                    <fileset dir="src/main/plugin-resources"/>
                                </copy>

                                <!-- Each scenario plugin is staged on its own, so its jar carries only
                                     its own classes and its own SPI entry. Sharing one service file
                                     would make every jar load every plugin. -->
                                <mkdir dir="${project.build.directory}/redaction-plugin"/>
                                <copy todir="${project.build.directory}/redaction-plugin">
                                    <fileset dir="${project.build.outputDirectory}" includes="com/github/cc11001100/weavergirl/sample/redaction/RedactionPlugin*.class"/>
                                </copy>
                                <copy todir="${project.build.directory}/redaction-plugin">
                                    <fileset dir="src/main/plugin-resources-redaction"/>
                                </copy>

                                <mkdir dir="${project.build.directory}/resilience-plugin"/>
                                <copy todir="${project.build.directory}/resilience-plugin">
                                    <fileset dir="${project.build.outputDirectory}" includes="com/github/cc11001100/weavergirl/sample/resilience/ResiliencePlugin*.class"/>
                                </copy>
                                <copy todir="${project.build.directory}/resilience-plugin">
                                    <fileset dir="src/main/plugin-resources-resilience"/>
                                </copy>

                                <!-- The log-correlation demo plugin: bridges the trace context into the
                                     MDC while TicketService.handleTicket runs (issue #45). -->
                                <mkdir dir="${project.build.directory}/log-correlation-plugin"/>
                                <copy todir="${project.build.directory}/log-correlation-plugin">
                                    <fileset dir="${project.build.outputDirectory}" includes="com/github/cc11001100/weavergirl/sample/logcorrelation/LogCorrelationPlugin*.class"/>
                                </copy>
                                <copy todir="${project.build.directory}/log-correlation-plugin">
                                    <fileset dir="src/main/plugin-resources-log-correlation"/>
                                </copy>

                                <!-- The account guard: field read/write hooks plus a catch hook, the
                                     three join points a method interceptor cannot express. -->
                                <mkdir dir="${project.build.directory}/account-guard-plugin"/>
                                <copy todir="${project.build.directory}/account-guard-plugin">
                                    <fileset dir="${project.build.outputDirectory}" includes="com/github/cc11001100/weavergirl/sample/account/AccountGuardPlugin*.class"/>
                                </copy>
                                <copy todir="${project.build.directory}/account-guard-plugin">
                                    <fileset dir="src/main/plugin-resources-account"/>
                                </copy>

                                <!-- CSV export as an introduction (mixin): adds an interface to a
                                     class instead of intercepting a method. -->
                                <mkdir dir="${project.build.directory}/csv-export-plugin"/>
                                <copy todir="${project.build.directory}/csv-export-plugin">
                                    <fileset dir="${project.build.outputDirectory}" includes="com/github/cc11001100/weavergirl/sample/billing/CsvExportPlugin*.class"/>
                                </copy>
                                <copy todir="${project.build.directory}/csv-export-plugin">
                                    <fileset dir="src/main/plugin-resources-billing"/>
                                </copy>

                                <!-- Call-site tracing: records who called a shared service. -->
                                <mkdir dir="${project.build.directory}/callsite-trace-plugin"/>
                                <copy todir="${project.build.directory}/callsite-trace-plugin">
                                    <fileset dir="${project.build.outputDirectory}" includes="com/github/cc11001100/weavergirl/sample/search/CallsiteTracePlugin*.class"/>
                                </copy>
                                <copy todir="${project.build.directory}/callsite-trace-plugin">
                                    <fileset dir="src/main/plugin-resources-search"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>audit-plugin-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>audit-plugin</classifier>
                            <classesDirectory>${project.build.directory}/audit-plugin</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>redaction-plugin-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>redaction-plugin</classifier>
                            <classesDirectory>${project.build.directory}/redaction-plugin</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>resilience-plugin-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>resilience-plugin</classifier>
                            <classesDirectory>${project.build.directory}/resilience-plugin</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>log-correlation-plugin-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>log-correlation-plugin</classifier>
                            <classesDirectory>${project.build.directory}/log-correlation-plugin</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>account-guard-plugin-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>account-guard-plugin</classifier>
                            <classesDirectory>${project.build.directory}/account-guard-plugin</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>csv-export-plugin-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>csv-export-plugin</classifier>
                            <classesDirectory>${project.build.directory}/csv-export-plugin</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>callsite-trace-plugin-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>callsite-trace-plugin</classifier>
                            <classesDirectory>${project.build.directory}/callsite-trace-plugin</classesDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.7.0</version>
                <configuration>
                    <mainClass>com.github.cc11001100.weavergirl.sample.app.SampleApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <moduleinfo.skip>true</moduleinfo.skip>
        <!-- This module is a demo application, not a published library: its value is the scenarios
             it demonstrates and the attach tests that run against it, not the line coverage of the
             demo endpoints. Coverage stays enforced on the API, core, agent, and capability jars. -->
        <jacoco.skip>true</jacoco.skip>
    </properties>

    <dependencies>
        <!-- Sample plugins only need to depend on api (Plugin SDK), simulating real plugin development -->
        <dependency>
            <groupId>io.github.cc11001100</groupId>
            <artifactId>weaver-girl-api</artifactId>
        </dependency>
        <!-- Runtime needs core for integration testing -->
        <dependency>
            <groupId>io.github.cc11001100</groupId>
            <artifactId>weaver-girl-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-process harness: attach the agent, install a plugin, weave one class. -->
        <dependency>
            <groupId>io.github.cc11001100</groupId>
            <artifactId>weaver-girl-testkit</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Embedded Jetty for demonstrating Servlet plugin -->
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
            <version>9.4.58.v20250814</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-servlet</artifactId>
            <version>9.4.58.v20250814</version>
        </dependency>
        <!-- javax.servlet API (Jetty 9 uses javax namespace).
             Compile scope (not provided): this is a standalone embedded-Jetty app
             run via `java -cp`/`-jar`, not a WAR deployed to a container that
             provides the servlet API, so it must carry it on its runtime classpath. -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
        </dependency>

        <!-- H2 in-memory database for demonstrating JDBC plugin.
             2.2.224 is the last release whose root classes are Java 8 bytecode
             (major 52, Build-Jdk 1.8; newer APIs live under META-INF/versions).
             2.3+ is class-file 55 and will not load on JDK 8, which this sample
             has to run on: it is the HTTP + JDBC attach proof for the agent. -->
        <!-- Logback is the demo's logging backend: the log-correlation demo configures its pattern at
             runtime so the %X{traceId} fields are actually printed. Compile scope because the demo
             plugin puts trace fields into the MDC through SLF4J. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.6.8</version>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
