<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.cc11001100</groupId>
        <artifactId>weaver-girl</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>weaver-girl-sample</artifactId>
    <packaging>jar</packaging>

    <name>Weaver Girl - Sample</name>
    <description>Sample applications demonstrating Weaver Girl usage</description>

    <build>
        <plugins>
            <!-- The audit plugin ships as its own jar, the way a third-party plugin does: its own
                 SPI entry and its own contract declaration, dropped into plugins/ next to the agent.
                 It carries only the plugin classes, not the payment service, or the plugin would bring
                 the application along with it. The classes and the declarations come from different
                 directories, so they are staged into one directory and jarred from there. -->
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>stage-audit-plugin</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/audit-plugin"/>
                                <copy todir="${project.build.directory}/audit-plugin">
                                    <fileset dir="${project.build.outputDirectory}" includes="com/github/cc11001100/weavergirl/sample/audit/AuditPlugin*.class"/>
                                </copy>
                                <copy todir="${project.build.directory}/audit-plugin">
                                    <fileset dir="src/main/plugin-resources"/>
                                </copy>

                                <!-- Each scenario plugin is staged on its own, so its jar carries only
                                     its own classes and its own SPI entry. Sharing one service file
                                     would make every jar load every plugin. -->
                                <mkdir dir="${project.build.directory}/redaction-plugin"/>
                                <copy todir="${project.build.directory}/redaction-plugin">
                                    <fileset dir="${project.build.outputDirectory}" includes="com/github/cc11001100/weavergirl/sample/redaction/RedactionPlugin*.class"/>
                                </copy>
                                <copy todir="${project.build.directory}/redaction-plugin">
                                    <fileset dir="src/main/plugin-resources-redaction"/>
                                </copy>

                                <mkdir dir="${project.build.directory}/resilience-plugin"/>
                                <copy todir="${project.build.directory}/resilience-plugin">
                                    <fileset dir="${project.build.outputDirectory}" includes="com/github/cc11001100/weavergirl/sample/resilience/ResiliencePlugin*.class"/>
                                </copy>
                                <copy todir="${project.build.directory}/resilience-plugin">
                                    <fileset dir="src/main/plugin-resources-resilience"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>audit-plugin-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>audit-plugin</classifier>
                            <classesDirectory>${project.build.directory}/audit-plugin</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>redaction-plugin-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>redaction-plugin</classifier>
                            <classesDirectory>${project.build.directory}/redaction-plugin</classesDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>resilience-plugin-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>resilience-plugin</classifier>
                            <classesDirectory>${project.build.directory}/resilience-plugin</classesDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.github.cc11001100.weavergirl.sample.app.SampleApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <moduleinfo.skip>true</moduleinfo.skip>
    </properties>

    <dependencies>
        <!-- Sample plugins only need to depend on api (Plugin SDK), simulating real plugin development -->
        <dependency>
            <groupId>com.github.cc11001100</groupId>
            <artifactId>weaver-girl-api</artifactId>
        </dependency>
        <!-- Runtime needs core for integration testing -->
        <dependency>
            <groupId>com.github.cc11001100</groupId>
            <artifactId>weaver-girl-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-process harness: attach the agent, install a plugin, weave one class. -->
        <dependency>
            <groupId>com.github.cc11001100</groupId>
            <artifactId>weaver-girl-testkit</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Embedded Jetty for demonstrating Servlet plugin -->
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
            <version>9.4.53.v20231009</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-servlet</artifactId>
            <version>9.4.53.v20231009</version>
        </dependency>
        <!-- javax.servlet API (Jetty 9 uses javax namespace).
             Compile scope (not provided): this is a standalone embedded-Jetty app
             run via `java -cp`/`-jar`, not a WAR deployed to a container that
             provides the servlet API, so it must carry it on its runtime classpath. -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>3.1.0</version>
        </dependency>

        <!-- H2 in-memory database for demonstrating JDBC plugin -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.5.250</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
