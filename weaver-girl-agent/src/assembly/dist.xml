<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.1"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.1 https://maven.apache.org/xsd/assembly-2.1.1.xsd">
    <!-- The only supported installation layout: the agent jar and its plugins/ directory side by
         side. The agent discovers built-in capabilities from that directory at startup, so a
         jar-only download would run with no instrumentation plugins at all. -->
    <id>dist</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>weaver-girl-agent-${project.version}</baseDirectory>

    <files>
        <file>
            <source>${project.build.directory}/${project.build.finalName}.jar</source>
            <outputDirectory>/</outputDirectory>
        </file>
        <file>
            <source>${project.basedir}/../weaver-example.yml</source>
            <outputDirectory>/</outputDirectory>
        </file>
        <file>
            <source>${project.basedir}/../README.md</source>
            <outputDirectory>/</outputDirectory>
        </file>
        <file>
            <source>${project.basedir}/../LICENSE</source>
            <outputDirectory>/</outputDirectory>
        </file>
    </files>

    <fileSets>
        <fileSet>
            <directory>${project.build.directory}/plugins</directory>
            <outputDirectory>plugins</outputDirectory>
            <includes>
                <include>*.jar</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
    </fileSets>
</assembly>
