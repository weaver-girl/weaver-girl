<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.cc11001100</groupId>
        <artifactId>weaver-girl</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>weaver-girl-sample</artifactId>
    <packaging>jar</packaging>

    <name>Weaver Girl - Sample</name>
    <description>Sample applications demonstrating Weaver Girl usage</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.github.cc11001100.weavergirl.sample.app.SampleApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- Sample plugins only need to depend on api (Plugin SDK), simulating real plugin development -->
        <dependency>
            <groupId>com.github.cc11001100</groupId>
            <artifactId>weaver-girl-api</artifactId>
        </dependency>
        <!-- Runtime needs core for integration testing -->
        <dependency>
            <groupId>com.github.cc11001100</groupId>
            <artifactId>weaver-girl-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Embedded Jetty for demonstrating Servlet plugin -->
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
            <version>9.4.53.v20231009</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-servlet</artifactId>
            <version>9.4.53.v20231009</version>
        </dependency>
        <!-- javax.servlet API (Jetty 9 uses javax namespace).
             Compile scope (not provided): this is a standalone embedded-Jetty app
             run via `java -cp`/`-jar`, not a WAR deployed to a container that
             provides the servlet API, so it must carry it on its runtime classpath. -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>3.1.0</version>
        </dependency>

        <!-- H2 in-memory database for demonstrating JDBC plugin -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.5.250</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
